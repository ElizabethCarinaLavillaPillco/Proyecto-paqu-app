<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fondo blanco que resalte sobre el crema -->
    <solid android:color="#FFFFFF" />

    <!-- Bordes redondeados -->
    <corners android:radius="12dp" />

    <!-- Borde naranja suave -->
    <stroke
        android:width="1.5dp"
        android:color="#FFCC80" />

    <!-- Padding interno para que el texto no se pegue -->
    <padding
        android:left="14dp"
        android:top="12dp"
        android:right="14dp"
        android:bottom="12dp" />

</shape>