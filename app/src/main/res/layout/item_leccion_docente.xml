<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardLeccionDocente"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/bg_card"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ═══════════════════════════════════
             FILA SUPERIOR: Nivel + Estado + Eliminar
             ═══════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Badge Nivel -->
            <TextView
                android:id="@+id/tvNivelLeccion"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="Básico"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_nivel_badge"/>

            <!-- Badge Categoría -->
            <TextView
                android:id="@+id/tvCategoriaLeccion"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="Saludos"
                android:textSize="11sp"
                android:textColor="@color/text_tertiary"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_categoria_badge"
                android:layout_marginStart="8dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <!-- Estado -->
            <TextView
                android:id="@+id/tvEstadoLeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ Activa"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/success"
                android:layout_marginEnd="12dp"/>

            <!-- Switch Activa/Inactiva -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchActivaLeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:thumbTint="@color/white"
                app:trackTint="@drawable/switch_track_color"
                app:switchMinWidth="44dp"/>

            <!-- Botón Eliminar (ROJO) -->
            <ImageView
                android:id="@+id/btnEliminarLeccion"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_delete"
                android:padding="8dp"
                android:background="@drawable/bg_btn_delete"
                android:contentDescription="Eliminar lección"
                app:tint="@color/danger"/>

        </LinearLayout>

        <!-- ═══════════════════════════════════
             TÍTULO
             ═══════════════════════════════════ -->
        <TextView
            android:id="@+id/tvTituloLeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lecciones de Saludos en Quechua"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="14dp"/>

        <!-- ═══════════════════════════════════
             DESCRIPCIÓN
             ═══════════════════════════════════ -->
        <TextView
            android:id="@+id/tvDescripcionLeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aprende los saludos más comunes del quechua con ejercicios interactivos"
            android:textSize="13sp"
            android:textColor="@color/text_hint"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"/>

        <!-- ═══════════════════════════════════
             FILA INFERIOR: Ejercicios + EXP + Fecha
             ═══════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp"
            android:paddingTop="12dp"
            android:background="@drawable/bg_info_bar_leccion">

            <!-- Ejercicios + EXP -->
            <TextView
                android:id="@+id/tvEjerciciosLeccion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📝 5 ejercicios • ⭐ 30 EXP"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:drawablePadding="0dp"/>

            <!-- Fecha -->
            <TextView
                android:id="@+id/tvFechaLeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15/01/2025"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:drawableStart="@drawable/ic_calendar_small"
                android:drawablePadding="4dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>