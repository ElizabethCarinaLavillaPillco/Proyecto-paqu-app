<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main">

  <!-- Cabecera superior elegante -->
  <androidx.cardview.widget.CardView
      android:id="@+id/headerCard"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_alignParentTop="true"
      app:cardCornerRadius="0dp"
      app:cardElevation="8dp"
      app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F59E0B"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

      <!-- Idioma (Bandera quechua) - CLICKEABLE PARA ABRIR MAPA -->
      <androidx.cardview.widget.CardView
          android:id="@+id/cardMapaVariantes"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?android:attr/selectableItemBackground"
          app:cardCornerRadius="16dp"
          app:cardElevation="4dp"
          app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

          <!-- ⭐ IMAGEN CLICKEABLE ⭐ -->
          <ImageView
              android:id="@+id/ivMapaQuechua"
              android:layout_width="48dp"
              android:layout_height="48dp"
              android:src="@drawable/cuscoicon"
              android:contentDescription="Mapa de Variantes del Quechua"
              android:clickable="true"
              android:focusable="true" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Quechua"
              android:textColor="#6366F1"
              android:textSize="11sp"
              android:textStyle="bold"
              android:layout_marginTop="4dp" />

          <!-- ⭐ INDICADOR DE QUE ES CLICKEABLE ⭐ -->
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="🗺️"
              android:textSize="12sp"
              android:layout_marginTop="2dp" />
        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <!-- Días de racha -->
      <androidx.cardview.widget.CardView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="10dp"
          app:cardCornerRadius="16dp"
          app:cardElevation="4dp"
          app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

          <ImageView
              android:layout_width="30dp"
              android:layout_height="30dp"
              android:src="@drawable/fuegoicono"
              android:contentDescription="Racha" />

          <TextView
              android:id="@+id/streakDays"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="0"
              android:textColor="#1F2937"
              android:textSize="20sp"
              android:textStyle="bold"
              android:layout_marginTop="4dp" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Días"
              android:textColor="#6B7280"
              android:textSize="10sp"
              android:textStyle="bold" />
        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <!-- Diamantes -->
      <androidx.cardview.widget.CardView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="10dp"
          app:cardCornerRadius="16dp"
          app:cardElevation="4dp"
          app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

          <ImageView
              android:layout_width="30dp"
              android:layout_height="30dp"
              android:src="@drawable/diamanteicon"
              android:contentDescription="Diamantes" />

          <TextView
              android:id="@+id/diamondsCount"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="0"
              android:textColor="#1F2937"
              android:textSize="20sp"
              android:textStyle="bold"
              android:layout_marginTop="4dp" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Gemas"
              android:textColor="#6B7280"
              android:textSize="10sp"
              android:textStyle="bold" />
        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <!-- Vidas -->
      <androidx.cardview.widget.CardView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="10dp"
          app:cardCornerRadius="16dp"
          app:cardElevation="4dp"
          app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

          <ImageView
              android:layout_width="30dp"
              android:layout_height="30dp"
              android:src="@drawable/corazonicon"
              android:contentDescription="Vidas" />

          <TextView
              android:id="@+id/livesCount"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="5"
              android:textColor="#1F2937"
              android:textSize="20sp"
              android:textStyle="bold"
              android:layout_marginTop="4dp" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Vidas"
              android:textColor="#6B7280"
              android:textSize="10sp"
              android:textStyle="bold" />
        </LinearLayout>
      </androidx.cardview.widget.CardView>
    </LinearLayout>
  </androidx.cardview.widget.CardView>

  <!-- Sección 1: Saludos con diseño armonioso -->
  <androidx.cardview.widget.CardView
      android:id="@+id/stickySection"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_below="@id/headerCard"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="16dp"
      android:layout_marginTop="20dp"
      android:layout_marginBottom="16dp"
      app:cardCornerRadius="20dp"
      app:cardElevation="8dp"
      app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:id="@+id/sectionContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="24dp">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚"
            android:textSize="32sp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

          <TextView
              android:id="@+id/tvSectionNumber"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Sección 1"
              android:textColor="#1F2937"
              android:textSize="13sp"
              android:alpha="0.9" />

          <TextView
              android:id="@+id/tvSectionTitle"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Saludos"
              android:textColor="#1F2937"
              android:textSize="24sp"
              android:textStyle="bold" />
        </LinearLayout>


      </LinearLayout>

      <TextView
          android:id="@+id/tvSectionDescription"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="Aprende los saludos básicos en Quechua"
          android:textColor="#1F2937"
          android:textSize="15sp"
          android:alpha="0.95"
          android:layout_marginBottom="16dp" />
      <ProgressBar
          android:id="@+id/sectionProgressBar"
          style="?android:attr/progressBarStyleHorizontal"
          android:layout_width="match_parent"
          android:layout_height="18dp"
          android:max="100"
          android:progress="0"
          android:progressDrawable="@drawable/progress_bar_general"/>

      <TextView
          android:id="@+id/tvPorcentajeCompletado"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="0% completado"
          android:textColor="#1F2937"
          android:textSize="12sp"
          android:layout_marginTop="8dp"
          android:alpha="0.9"/>
    </LinearLayout>
  </androidx.cardview.widget.CardView>

  <!-- ScrollView para el contenido desplazable -->
  <ScrollView
      android:id="@+id/mainScrollView"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_above="@+id/bottomNavigation"
      android:layout_below="@id/stickySection"
      android:fillViewport="true"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

      <!-- Banner motivacional -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardCornerRadius="20dp"
          app:cardElevation="6dp"
          app:cardBackgroundColor="#FFFFFF"
          android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="🎯"
              android:textSize="42sp"
              android:layout_marginEnd="16dp" />

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu Camino de Aprendizaje"
                android:textColor="#1F2937"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completa cada nivel para desbloquear el siguiente"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
          </LinearLayout>
        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <!-- Niveles (camino como Duolingo) -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">

        <!-- Nivel 1 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/level1Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F59E0B">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:padding="20dp"
              android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

              <TextView
                  android:id="@+id/level1Title"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Nivel 1"
                  android:textColor="#FFFFFF"
                  android:textSize="18sp"
                  android:textStyle="bold" />

              <TextView
                  android:id="@+id/level1Description"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Saludos básicos"
                  android:textColor="#FFFFFF"
                  android:textSize="13sp"
                  android:alpha="0.9"
                  android:layout_marginTop="4dp" />

              <ProgressBar
                  android:id="@+id/level1Progress"
                  style="?android:attr/progressBarStyleHorizontal"
                  android:layout_width="match_parent"
                  android:layout_height="6dp"
                  android:progress="0"
                  android:layout_marginTop="8dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/level1StatusIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_cross"
                android:contentDescription="Estado"
                android:layout_marginStart="16dp" />
          </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Nivel 2 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/level2Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F59E0B">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:padding="20dp"
              android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

              <TextView
                  android:id="@+id/level2Title"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Nivel 2"
                  android:textColor="#FFFFFF"
                  android:textSize="18sp"
                  android:textStyle="bold" />

              <TextView
                  android:id="@+id/level2Description"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Presentaciones"
                  android:textColor="#FFFFFF"
                  android:textSize="13sp"
                  android:alpha="0.9"
                  android:layout_marginTop="4dp" />

              <ProgressBar
                  android:id="@+id/level2Progress"
                  style="?android:attr/progressBarStyleHorizontal"
                  android:layout_width="match_parent"
                  android:layout_height="6dp"
                  android:progress="0"
                  android:layout_marginTop="8dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/level2StatusIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_cross"
                android:contentDescription="Estado"
                android:layout_marginStart="16dp" />
          </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Nivel 3 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/level3Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F59E0B">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:padding="20dp"
              android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

              <TextView
                  android:id="@+id/level3Title"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Nivel 3"
                  android:textColor="#FFFFFF"
                  android:textSize="18sp"
                  android:textStyle="bold" />

              <TextView
                  android:id="@+id/level3Description"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Familia"
                  android:textColor="#FFFFFF"
                  android:textSize="13sp"
                  android:alpha="0.9"
                  android:layout_marginTop="4dp" />

              <ProgressBar
                  android:id="@+id/level3Progress"
                  style="?android:attr/progressBarStyleHorizontal"
                  android:layout_width="match_parent"
                  android:layout_height="6dp"
                  android:progress="0"
                  android:layout_marginTop="8dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/level3StatusIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_cross"
                android:contentDescription="Estado"
                android:layout_marginStart="16dp" />
          </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Nivel 4 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/level4Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F59E0B">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:padding="20dp"
              android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

              <TextView
                  android:id="@+id/level4Title"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Nivel 4"
                  android:textColor="#FFFFFF"
                  android:textSize="18sp"
                  android:textStyle="bold" />

              <TextView
                  android:id="@+id/level4Description"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Números"
                  android:textColor="#FFFFFF"
                  android:textSize="13sp"
                  android:alpha="0.9"
                  android:layout_marginTop="4dp" />

              <ProgressBar
                  android:id="@+id/level4Progress"
                  style="?android:attr/progressBarStyleHorizontal"
                  android:layout_width="match_parent"
                  android:layout_height="6dp"
                  android:progress="0"
                  android:layout_marginTop="8dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/level4StatusIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_cross"
                android:contentDescription="Estado"
                android:layout_marginStart="16dp" />
          </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Nivel 5 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/level5Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F59E0B">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:padding="20dp"
              android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

              <TextView
                  android:id="@+id/level5Title"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Nivel 5"
                  android:textColor="#FFFFFF"
                  android:textSize="18sp"
                  android:textStyle="bold" />

              <TextView
                  android:id="@+id/level5Description"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Colores"
                  android:textColor="#FFFFFF"
                  android:textSize="13sp"
                  android:alpha="0.9"
                  android:layout_marginTop="4dp" />

              <ProgressBar
                  android:id="@+id/level5Progress"
                  style="?android:attr/progressBarStyleHorizontal"
                  android:layout_width="match_parent"
                  android:layout_height="6dp"
                  android:progress="0"
                  android:layout_marginTop="8dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/level5StatusIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_cross"
                android:contentDescription="Estado"
                android:layout_marginStart="16dp" />
          </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Nivel 6 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/level6Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F59E0B">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:padding="20dp"
              android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

              <TextView
                  android:id="@+id/level6Title"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Nivel 6"
                  android:textColor="#FFFFFF"
                  android:textSize="18sp"
                  android:textStyle="bold" />

              <TextView
                  android:id="@+id/level6Description"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Comida"
                  android:textColor="#FFFFFF"
                  android:textSize="13sp"
                  android:alpha="0.9"
                  android:layout_marginTop="4dp" />

              <ProgressBar
                  android:id="@+id/level6Progress"
                  style="?android:attr/progressBarStyleHorizontal"
                  android:layout_width="match_parent"
                  android:layout_height="6dp"
                  android:progress="0"
                  android:layout_marginTop="8dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/level6StatusIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_cross"
                android:contentDescription="Estado"
                android:layout_marginStart="16dp" />
          </LinearLayout>
        </androidx.cardview.widget.CardView>
      </LinearLayout>

      <!-- Mensaje motivacional final -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardCornerRadius="20dp"
          app:cardElevation="6dp"
          app:cardBackgroundColor="#ECFDF5"
          android:layout_marginTop="24dp"
          android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="💪"
              android:textSize="38sp"
              android:layout_marginEnd="12dp" />

          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="¡Sigue practicando todos los días para mantener tu racha!"
              android:textColor="#065F46"
              android:textSize="14sp"
              android:textStyle="bold" />
        </LinearLayout>
      </androidx.cardview.widget.CardView>
    </LinearLayout>
  </ScrollView>

  <!-- Barra de navegación inferior -->
  <com.google.android.material.bottomnavigation.BottomNavigationView
      android:id="@+id/bottomNavigation"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_alignParentBottom="true"
      android:background="@color/white"
      android:elevation="8dp"
      app:menu="@menu/bottom_nav_menu" />

  <!-- BURBUJAS FLOTANTES ARRASTRABLES -->

  <!-- Burbuja de Repaso -->
  <androidx.cardview.widget.CardView
      android:id="@+id/draggableBubble"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_alignParentEnd="true"
      android:layout_centerVertical="true"
      android:layout_marginEnd="16dp"
      app:cardCornerRadius="50dp"
      app:cardElevation="16dp"
      android:elevation="100dp"
      android:translationZ="100dp"
      app:cardBackgroundColor="#6366F1">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bubble_gradient_bg"
