<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_leccion_dinamica.xml
    Pantalla que ejecuta los ejercicios dinámicos de una lección del docente.
    El contenedorEjercicio se limpia y rellena dinámicamente según el tipo de ejercicio.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8E1">

    <!-- ══════════════════════════════
         HEADER
    ══════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_docente"
        android:paddingTop="40dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="16dp"
        android:orientation="vertical">

        <!-- Fila: back + título + vidas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnBackToMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_close"
                android:padding="6dp"
                android:background="@drawable/bg_circle_alpha"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvTituloLeccionDin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lección"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="8dp"/>

            <!-- Vidas -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_stat_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❤️ "
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/livesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Barra de progreso + número -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <ProgressBar
                android:id="@+id/progressBarLeccion"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_weight="1"
                android:progress="0"
                android:max="100"
                android:progressDrawable="@drawable/progress_bar_general"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvNumeroPregunta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 / 3"
                android:textColor="#FFECB3"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ══════════════════════════════
         LOADER (mientras carga Firebase)
    ══════════════════════════════ -->
    <ProgressBar
        android:id="@+id/progressBarCargaLeccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="80dp"
        android:visibility="gone"/>

    <!-- ══════════════════════════════
         CONTENEDOR DINÁMICO DE EJERCICIOS
         Se llena programáticamente según el tipo
    ══════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contenedorEjercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"/>
    </ScrollView>

</LinearLayout>