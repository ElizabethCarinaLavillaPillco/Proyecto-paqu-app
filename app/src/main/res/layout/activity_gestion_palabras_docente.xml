<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ═══════════════════════════════════
             TOOLBAR
             ═══════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:background="@color/bg_main"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_arrow_back"
                android:padding="10dp"
                android:background="@drawable/bg_btn_icon_rounded"
                android:contentDescription="Volver"
                app:tint="@color/primary_dark"/>

            <TextView
                android:id="@+id/tvTituloGestion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📖 Diccionario Quechua"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginStart="8dp"/>

            <TextView
                android:id="@+id/tvContadorPalabrasDocente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 palabras"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:background="@drawable/bg_counter_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>

        </LinearLayout>

        <!-- ═══════════════════════════════════
             BARRA DE BÚSQUEDA
             ═══════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Buscar en quechua o español..."
                app:hintTextColor="@color/primary"
                app:boxStrokeColor="@color/primary"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/text_hint"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBuscarPalabraDocente"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- ═══════════════════════════════════
             CHIPS DE CATEGORÍA
             ═══════════════════════════════════ -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategoriasDocente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacingHorizontal="8dp">

                <!-- Chip: Todas -->
                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Todas"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="@color/primary"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="36dp"
                    app:chipStartPadding="12dp"
                    app:chipEndPadding="12dp"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>

                <!-- Chip: Saludos -->
                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="👋 Saludos"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/chip_saludos"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="36dp"
                    app:chipStartPadding="12dp"
                    app:chipEndPadding="12dp"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>

                <!-- Chip: Familia -->
                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="👨‍👩‍👧 Familia"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/chip_familia"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="36dp"
                    app:chipStartPadding="12dp"
                    app:chipEndPadding="12dp"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>

                <!-- Chip: Naturaleza -->
                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🌿 Naturaleza"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/chip_naturaleza"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="36dp"
                    app:chipStartPadding="12dp"
                    app:chipEndPadding="12dp"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>

                <!-- Chip: Números -->
                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🔢 Números"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/chip_numeros"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="36dp"
                    app:chipStartPadding="12dp"
                    app:chipEndPadding="12dp"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>

                <!-- Chip: Colores -->
                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🎨 Colores"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/chip_colores"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="36dp"
                    app:chipStartPadding="12dp"
                    app:chipEndPadding="12dp"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>

                <!-- Chip: Animales -->
                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🐾 Animales"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/chip_animales"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="36dp"
                    app:chipStartPadding="12dp"
                    app:chipEndPadding="12dp"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>

                <!-- Chip: Verbos -->
                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🏃 Verbos"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/chip_verbos"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="36dp"
                    app:chipStartPadding="12dp"
                    app:chipEndPadding="12dp"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>

                <!-- Chip: Frases -->
                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="💬 Frases"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/chip_frases"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="36dp"
                    app:chipStartPadding="12dp"
                    app:chipEndPadding="12dp"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>

                <!-- Chip: Otra -->
                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="📌 Otra"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/chip_otra"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="36dp"
                    app:chipStartPadding="12dp"
                    app:chipEndPadding="12dp"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <!-- Línea divisora -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>

        <!-- ═══════════════════════════════════
             RECYCLER VIEW
             ═══════════════════════════════════ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPalabrasDocente"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="80dp"/>

        <!-- ═══════════════════════════════════
             ESTADO VACÍO
             ═══════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutVacioPalabras"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:paddingStart="40dp"
            android:paddingEnd="40dp">

            <LinearLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/bg_empty_state_circle"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_translate"
                    app:tint="@color/primary_light"
                    android:alpha="0.7"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diccionario vacío"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agrega palabras al diccionario con el botón +\ny estarán disponibles para las lecciones"
                android:textSize="14sp"
                android:textColor="@color/text_hint"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ═══════════════════════════════════
         FAB: AGREGAR PALABRA
         ═══════════════════════════════════ -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregarPalabra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/ic_add_circle"
        android:contentDescription="Agregar palabra"
        app:backgroundTint="@color/accent_red"
        app:tint="@color/white"
        app:elevation="8dp"
        app:fabSize="normal"
        app:rippleColor="@color/ripple_color"
        app:borderWidth="0dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>