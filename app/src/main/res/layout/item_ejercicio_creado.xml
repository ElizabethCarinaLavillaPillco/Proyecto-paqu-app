<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/bg_card"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila superior: Número + Tipo + Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Número del ejercicio -->
            <TextView
                android:id="@+id/tvNumeroEjercicio"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_number_circle"
                android:gravity="center"/>

            <!-- Tipo de ejercicio -->
            <TextView
                android:id="@+id/tvTipoEjercicio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎵 selección múltiple"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_type_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>

            <!-- Botón Editar (NARANJA) -->
            <ImageView
                android:id="@+id/btnEditarEjercicio"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_edit"
                android:padding="8dp"
                android:background="@drawable/bg_btn_edit"
                android:contentDescription="Editar ejercicio"
                app:tint="@color/edit"
                android:layout_marginStart="8dp"/>

            <!-- Botón Eliminar (ROJO) -->
            <ImageView
                android:id="@+id/btnEliminarEjercicio"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_delete"
                android:padding="8dp"
                android:background="@drawable/bg_btn_delete"
                android:contentDescription="Eliminar ejercicio"
                app:tint="@color/danger"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

        <!-- Pregunta -->
        <TextView
            android:id="@+id/tvPreguntaEjercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Qué significa esta palabra?"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="12dp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <!-- Respuesta correcta (con fondo verde suave) -->
        <TextView
            android:id="@+id/tvRespuestaEjercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ Allin p'unchay"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_success"
            android:background="@drawable/bg_response_correct"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginTop="8dp"/>

        <!-- Opciones (si aplica) -->
        <TextView
            android:id="@+id/tvOpcionesEjercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Opciones: Allin, p'unchay, tuta, samay"
            android:textSize="12sp"
            android:textColor="@color/text_tertiary"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:ellipsize="end"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>