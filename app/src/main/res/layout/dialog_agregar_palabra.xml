<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_dialog"
    android:padding="24dp">

    <!-- Título dinámico -->
    <TextView
        android:id="@+id/tvDialogoPalabraTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="➕ Nueva Palabra"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/primary_dark"
        android:layout_marginBottom="20dp"/>

    <!-- Quechua -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Palabra en Quechua *"
        app:hintTextColor="@color/primary"
        app:boxStrokeColor="@color/primary"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:startIconDrawable="@drawable/ic_language_small"
        app:startIconTint="@color/accent_red"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPalabraQuechua"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:inputType="text"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Español -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Traducción en Español *"
        app:hintTextColor="@color/accent_yellow_dark"
        app:boxStrokeColor="@color/accent_yellow_dark"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        android:layout_marginTop="12dp"
        app:startIconDrawable="@drawable/ic_translate_small"
        app:startIconTint="@color/accent_yellow_dark"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPalabraEspanol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:inputType="text"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Pronunciación -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Pronunciación (opcional)"
        app:hintTextColor="@color/edit"
        app:boxStrokeColor="@color/edit"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        android:layout_marginTop="12dp"
        app:startIconDrawable="@drawable/ic_volume_small"
        app:startIconTint="@color/edit"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPronunciacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:inputType="text"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Categoría (Spinner con estilo Material) -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Categoría"
        app:hintTextColor="@color/info"
        app:boxStrokeColor="@color/info"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        android:layout_marginTop="12dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

        <AutoCompleteTextView
            android:id="@+id/spinnerCategoriaWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/text_primary"
            android:textSize="14sp"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Nota informativa -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💡 Los campos con * son obligatorios. La pronunciación se usará para el audio."
        android:textSize="11sp"
        android:textColor="@color/text_hint"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="2dp"/>

</LinearLayout>