<?xml version="1.0" encoding="utf-8"?>
<!--
    item_usuario_admin.xml
    Card de un usuario en la lista del panel de administración.
    Muestra: avatar con inicial + nombre + email + badge de rol + botones acción.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="?attr/selectableItemBackground">

    <!-- Avatar circular con inicial -->
    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginEnd="14dp">

        <!-- Círculo de fondo (color se setea por código) -->
        <ImageView
            android:id="@+id/ivAvatarCirculoAdmin"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/bg_avatar_circle"
            android:scaleType="fitXY"/>

        <!-- Inicial -->
        <TextView
            android:id="@+id/tvInicialAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="A"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>
    </FrameLayout>

    <!-- Info: nombre + email -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombreUsuarioAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del usuario"
            android:textColor="#1E1E24"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvEmailUsuarioAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="email@ejemplo.com"
            android:textColor="#757575"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"/>

        <!-- Badge de rol -->
        <TextView
            android:id="@+id/tvRolBadgeAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 Estudiante"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_badge_rol"/>
    </LinearLayout>

    <!-- Botón: cambiar rol -->
    <ImageView
        android:id="@+id/btnCambiarRolAdmin"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_edit"
        android:tint="#FF6F00"
        android:padding="6dp"
        android:background="@drawable/bg_btn_accion_naranja"
        android:layout_marginEnd="8dp"
        android:contentDescription="Cambiar rol"/>

    <!-- Botón: eliminar -->
    <ImageView
        android:id="@+id/btnEliminarUsuarioAdmin"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_delete"
        android:tint="#D32F2F"
        android:padding="6dp"
        android:background="@drawable/bg_btn_accion_rojo"
        android:contentDescription="Eliminar usuario"/>

</LinearLayout>