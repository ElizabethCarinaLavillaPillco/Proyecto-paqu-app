<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    tools:context=".perfilActivity">

    <!-- Cabecera con gradiente -->
    <FrameLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@drawable/header_gradient_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Avatar con círculo -->
        <androidx.cardview.widget.CardView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            app:cardCornerRadius="70dp"
            app:cardElevation="12dp"
            android:layout_marginTop="20dp">

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/llamaparaperifl" />

        </androidx.cardview.widget.CardView>

        <!-- Botón configuración -->
        <ImageButton
            android:id="@+id/tuercaIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:padding="12dp"
            android:background="@drawable/option_background"
            app:srcCompat="@drawable/tuercaicon"
            app:tint="@color/white"
            android:contentDescription="Configuración" />
    </FrameLayout>

    <!-- Contenido con scroll ✅ CORREGIDO: paddingBottom para el bottom nav -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintTop_toBottomOf="@id/header_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Botón cambiar avatar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/EscojeAvatar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="✨ Cambiar Avatar"
                android:textStyle="bold"
                android:fontFamily="@font/fredoka_one"
                android:backgroundTint="@color/morado"
                android:textColor="@color/white"
                app:cornerRadius="20dp"
                app:icon="@drawable/ojoicono"
                app:iconTint="@color/white" />

            <!-- Card de información del usuario -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:backgroundTint="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvUsuario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nombre usuario"
                        android:fontFamily="@font/fredoka_one"
                        android:textSize="22sp"
                        android:textColor="@color/morado" />

                    <TextView
                        android:id="@+id/tvDescripcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@Usuario • Se unió en 20XX"
                        android:textColor="@color/gris"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvRol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="6dp"
                        android:text="USUARIO"
                        android:fontFamily="@font/fredoka_one"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_rol_usuario"
                        android:gravity="center" />

                    <!-- Idioma -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_stat_item">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:srcCompat="@drawable/cuscoicon" />

                        <TextView
                            android:id="@+id/textView19"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aprendiendo Quechua"
                            android:fontFamily="@font/fredoka_one"
                            android:textSize="16sp"
                            android:layout_marginStart="12dp"
                            android:textColor="@color/negro" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card de Seguidores/Siguiendo -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:backgroundTint="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👥 Social"
                        android:fontFamily="@font/fredoka_one"
                        android:textSize="18sp"
                        android:textColor="@color/morado"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- Siguiendo -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:background="@drawable/answer_gradient_bg">

                            <TextView
                                android:id="@+id/tvSiguiendo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:fontFamily="@font/fredoka_one"
                                android:textSize="28sp"
                                android:textColor="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Siguiendo"
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:alpha="0.9" />
                        </LinearLayout>

                        <View
                            android:layout_width="8dp"
                            android:layout_height="match_parent" />

                        <!-- Seguidores -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:background="@drawable/bubble_gradient_bg">

                            <TextView
                                android:id="@+id/tvSeguidores"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:fontFamily="@font/fredoka_one"
                                android:textSize="28sp"
                                android:textColor="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Seguidores"
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:alpha="0.9" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Botones de acción social -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAgregarAmigos"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Amigos"
                            android:fontFamily="@font/fredoka_one"
                            android:textColor="@color/morado"
                            app:strokeColor="@color/morado"
                            app:cornerRadius="20dp"
                            app:icon="@drawable/agregarpersonaicono"
                            app:iconTint="@color/morado"
                            android:layout_marginEnd="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCompartirPerfil"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:backgroundTint="@color/rosado"
                            app:cornerRadius="28dp"
                            app:icon="@drawable/compartir"
                            app:iconTint="@color/white"
                            app:iconPadding="0dp"
                            app:iconGravity="textStart" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card de Estadísticas -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:backgroundTint="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 Resumen"
                        android:textSize="18sp"
                        android:fontFamily="@font/fredoka_one"
                        android:textColor="@color/morado"
                        android:layout_marginBottom="12dp" />

                    <!-- EXP -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_stat_item"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:srcCompat="@drawable/rayoicono" />

                        <TextView
                            android:id="@+id/tvExp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/fredoka_one"
                            android:text="0"
                            android:textSize="20sp"
                            android:textColor="@color/amarillo" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="EXP Totales"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/fredoka_one"
                            android:textColor="@color/negro" />
                    </LinearLayout>

                    <!-- Puntaje -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_stat_item">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:srcCompat="@drawable/fuegoicono" />

                        <TextView
                            android:id="@+id/tvPuntaje"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/fredoka_one"
                            android:text="0"
                            android:textSize="20sp"
                            android:textColor="@color/naranja" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Días de racha"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/fredoka_one"
                            android:textColor="@color/negro" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card de Favoritos -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFavoritos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:backgroundTint="@color/white"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <!-- Ícono -->
                    <LinearLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/answer_orange_gradient_bg"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐"
                            android:textSize="32sp" />
                    </LinearLayout>

                    <!-- Contenido -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mis Favoritos"
                            android:fontFamily="@font/fredoka_one"
                            android:textSize="18sp"
                            android:textColor="@color/negro" />

                        <TextView
                            android:id="@+id/tvCantidadFavoritos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 palabras guardadas"
                            android:textSize="12sp"
                            android:textColor="@color/gris"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Flecha -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/gris_claro" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Barra inferior fija ✅ CORREGIDO: Posición fija en bottom -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/morado"
        app:itemTextColor="@color/morado"
        app:elevation="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>