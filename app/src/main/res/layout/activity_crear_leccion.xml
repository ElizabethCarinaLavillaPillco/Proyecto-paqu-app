<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═══════════════════════════════════
                 TOOLBAR CON INDICADOR DE EDICIÓN
                 ═══════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="12dp"
                android:background="@color/bg_main"
                android:elevation="2dp">

                <!-- Botón Atrás -->
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_arrow_back"
                    android:padding="10dp"
                    android:background="@drawable/bg_btn_icon_rounded"
                    android:contentDescription="Volver"
                    app:tint="@color/primary_dark"/>

                <!-- Título con badge de edición -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Editar Lección"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                    <!-- Badge Edición -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:text="EDITANDO"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:background="@drawable/bg_badge_editando"
                        android:layout_marginStart="10dp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ═══════════════════════════════════
                 AVISO INFERIOR DEL TOOLBAR
                 ═══════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/edit_bg"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_info_outline"
                    app:tint="@color/edit"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modifica los campos y presiona «Actualizar» para guardar los cambios"
                    android:textSize="12sp"
                    android:textColor="@color/edit"
                    android:layout_marginStart="8dp"
                    android:maxLines="2"
                    android:ellipsize="end"/>

            </LinearLayout>

            <!-- ═══════════════════════════════════
                 FORMULARIO DE INFORMACIÓN
                 ═══════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/bg_card"
                app:strokeColor="@color/edit_light"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Sección: Información -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_circle_edit"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_edit"
                                app:tint="@color/white"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Información de la lección"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/edit"
                            android:layout_marginStart="12dp"/>

                    </LinearLayout>

                    <!-- Campo: Título -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Título de la lección *"
                        app:hintTextColor="@color/edit"
                        app:boxStrokeColor="@color/edit"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTitulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:inputType="textCapSentences"
                            android:maxLines="2"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo: Descripción -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Descripción (opcional)"
                        app:hintTextColor="@color/edit"
                        app:boxStrokeColor="@color/edit"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        android:layout_marginTop="12dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDescripcion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:inputType="textMultiLine"
                            android:minLines="2"
                            android:maxLines="4"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo: Nivel -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nivel (Básico / Intermedio / Avanzado)"
                        app:hintTextColor="@color/edit"
                        app:boxStrokeColor="@color/edit"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        android:layout_marginTop="12dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNivel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:inputType="text"/>

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ═══════════════════════════════════
                 SECCIÓN: EJERCICIOS
                 ═══════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_icon_circle_primary"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_list"
                        app:tint="@color/white"/>

                </LinearLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ejercicios"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginStart="12dp"/>

            </LinearLayout>

            <!-- ═══════════════════════════════════
                 CONTAINER DINÁMICO DE EJERCICIOS
                 ═══════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/containerEjercicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:animateLayoutChanges="true"/>

            <!-- ═══════════════════════════════════
                 BOTÓN: AGREGAR EJERCICIO
                 ═══════════════════════════════════ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgregarEjercicio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:text="+ Agregar Ejercicio"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_add_circle_outline"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="@color/edit"
                app:backgroundTint="@color/edit_light"
                app:cornerRadius="14dp"
                app:elevation="0dp"
                app:rippleColor="#40FF6F00"
                app:strokeColor="@color/edit"
                app:strokeWidth="1dp"/>

            <!-- ═══════════════════════════════════
                 BOTÓN: PREVIEW (oculto por Java)
                 ═══════════════════════════════════ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreview"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:text="Vista Previa"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:icon="@drawable/ic_visibility"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="@color/accent_yellow_dark"
                app:backgroundTint="@color/accent_yellow_light"
                app:cornerRadius="14dp"
                app:elevation="0dp"
                app:strokeColor="@color/accent_yellow_dark"
                app:strokeWidth="1dp"
                android:visibility="gone"/>

            <!-- ═══════════════════════════════════
                 BOTÓN: ACTUALIZAR (Guardado principal)
                 ═══════════════════════════════════ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="32dp"
                android:text="Actualizar Lección"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_save"
                app:iconGravity="textStart"
                app:iconSize="22dp"
                app:iconTint="@color/white"
                app:backgroundTint="@color/edit"
                app:cornerRadius="16dp"
                app:elevation="6dp"
                app:rippleColor="@color/ripple_color"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
