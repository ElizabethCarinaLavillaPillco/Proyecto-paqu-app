<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/bg_card"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- ═══════════════════════════════════
             INDICADOR DE COLOR POR CATEGORÍA
             ═══════════════════════════════════ -->
        <View
            android:id="@+id/indicadorCategoriaPalabra"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/primary"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"/>

        <!-- ═══════════════════════════════════
             CONTENIDO PRINCIPAL
             ═══════════════════════════════════ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Fila: Quechua + Categoría -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPalabraQuechua"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Allin p'unchay"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_red_dark"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvCategoriaPalabra"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:text="Saludos"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/bg_categoria_badge_small"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <!-- Español -->
            <TextView
                android:id="@+id/tvPalabraEspanol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buenos días"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- Pronunciación -->
            <TextView
                android:id="@+id/tvPronunciacionPalabra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊 a-lin pun-chay"
                android:textSize="12sp"
                android:textColor="@color/edit"
                android:background="@drawable/bg_pronunciacion_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginTop="6dp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- Autor -->
            <TextView
                android:id="@+id/tvAutorPalabra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✏️ Yo"
                android:textSize="11sp"
                android:textColor="@color/edit"
                android:layout_marginTop="6dp"/>

        </LinearLayout>

        <!-- ═══════════════════════════════════
             BOTONES DE ACCIÓN
             ═══════════════════════════════════ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="8dp">

            <!-- Editar (NARANJA) -->
            <ImageView
                android:id="@+id/btnEditarPalabra"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_edit"
                android:padding="9dp"
                android:background="@drawable/bg_btn_edit"
                android:contentDescription="Editar palabra"
                app:tint="@color/edit"/>

            <!-- Eliminar (ROJO) -->
            <ImageView
                android:id="@+id/btnEliminarPalabra"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_delete"
                android:padding="9dp"
                android:background="@drawable/bg_btn_delete"
                android:contentDescription="Eliminar palabra"
                app:tint="@color/danger"
                android:layout_marginTop="6dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>