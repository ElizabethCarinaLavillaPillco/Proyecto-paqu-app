<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎮 Juego de Memoria"
            android:textSize="24sp"
            android:textColor="@color/primary_color"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardReset"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            android:backgroundTint="@color/primary_color">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_reset"
                android:tint="@android:color/white" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:weightSum="3">

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Puntaje: 0"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/rounded_stats"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvMoves"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Movimientos: 0"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/rounded_stats"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tiempo: 00:00"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/rounded_stats"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Grid de cartas -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:layout_marginBottom="16dp">

        <GridLayout
            android:id="@+id/gridMemoria"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="4"
            android:rowCount="3"
            android:padding="8dp" />

    </androidx.cardview.widget.CardView>

    <!-- Instrucciones -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Encuentra todos los pares de cartas en el menor tiempo posible"
        android:textSize="12sp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:padding="8dp" />

</LinearLayout>