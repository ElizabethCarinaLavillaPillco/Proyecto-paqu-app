<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main"
    android:padding="16dp">

    <!-- ScrollView para el contenido -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Título principal -->
            <TextView
                android:id="@+id/tvTituloCuentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📖 Cuentos en Acción"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:letterSpacing="0.02" />

            <!-- Subtítulo -->
            <TextView
                android:id="@+id/tvSubtituloCuentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explora historias interactivas en Quechua"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="32dp"
                android:alpha="0.8" />

            <!-- Filtro por botones toggle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Filtrar por tipo:"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                android:alpha="0.9" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:gravity="center">

                <!-- Filtro Historias -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/filterHistorias"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/filter_unselected">

                    <TextView
                        android:id="@+id/textFilterHistorias"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Historias"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:padding="8dp" />

                </androidx.cardview.widget.CardView>

                <!-- Filtro Infantil -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/filterInfantil"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/filter_unselected">

                    <TextView
                        android:id="@+id/textFilterInfantil"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Infantil"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:padding="8dp" />

                </androidx.cardview.widget.CardView>

                <!-- Filtro Leyendas -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/filterLeyendas"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/filter_unselected">

                    <TextView
                        android:id="@+id/textFilterLeyendas"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Leyendas"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:padding="8dp" />

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Lista de Cuentos -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cuentos disponibles:"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Cuento 1 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardCuento1"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <!-- Logo/Icono del cuento -->
                    <TextView
                        android:id="@+id/iconCuento1"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="📚"
                        android:textSize="30sp"
                        android:gravity="center"
                        android:layout_centerVertical="true" />

                    <!-- Contenido textual -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/iconCuento1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTituloCuento1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="La Leyenda del Zorro"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvResumenCuento1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Una antigua leyenda quechua sobre la sabiduría del zorro en los Andes..."
                            android:textColor="@color/grey"
                            android:textSize="12sp"
                            android:maxLines="2" />

                    </LinearLayout>

                    <!-- Badge tipo -->
                    <TextView
                        android:id="@+id/badgeTipo1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Leyenda"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:background="@color/morado"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        app:cardCornerRadius="8dp" />

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <!-- Cuento 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardCuento2"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <!-- Logo/Icono del cuento -->
                    <TextView
                        android:id="@+id/iconCuento2"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="👧"
                        android:textSize="30sp"
                        android:gravity="center"
                        android:layout_centerVertical="true" />

                    <!-- Contenido textual -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/iconCuento2"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTituloCuento2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aventuras en los Andes"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvResumenCuento2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="La historia de una niña quechua y sus aventuras diarias en las montañas..."
                            android:textColor="@color/grey"
                            android:textSize="12sp"
                            android:maxLines="2" />

                    </LinearLayout>

                    <!-- Badge tipo -->
                    <TextView
                        android:id="@+id/badgeTipo2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Infantil"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:background="@color/verde"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        app:cardCornerRadius="8dp" />

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <!-- Cuento 3 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardCuento3"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <!-- Logo/Icono del cuento -->
                    <TextView
                        android:id="@+id/iconCuento3"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="🌄"
                        android:textSize="30sp"
                        android:gravity="center"
                        android:layout_centerVertical="true" />

                    <!-- Contenido textual -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/iconCuento3"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTituloCuento3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="El Origen de las Montañas"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvResumenCuento3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Una historia tradicional sobre cómo se formaron las majestuosas montañas andinas..."
                            android:textColor="@color/grey"
                            android:textSize="12sp"
                            android:maxLines="2" />

                    </LinearLayout>

                    <!-- Badge tipo -->
                    <TextView
                        android:id="@+id/badgeTipo3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Historia"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:background="@color/azul"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        app:cardCornerRadius="8dp" />

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <!-- Barra de navegación inferior -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>