<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/gradient_background"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tvTituloPantalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="🏔️ Herramientas"
            android:fontFamily="@font/fredoka_one"
            android:textSize="24sp"
            android:textColor="@color/black" />
    </RelativeLayout>

    <!-- ScrollView para las cards -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <!-- CARD 1: TRADUCTOR -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTraductor"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/card_traductor_gradient"
                    android:padding="20dp">

                    <!-- Contenido izquierdo -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:orientation="vertical"
                        android:layout_toStartOf="@id/lottieTraductor">

                        <TextView
                            android:id="@+id/tvTituloTraductor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Traductor"
                            android:fontFamily="@font/fredoka_one"
                            android:textSize="22sp"
                            android:textColor="@color/white"
                            android:shadowColor="#40000000"
                            android:shadowDx="2"
                            android:shadowDy="2"
                            android:shadowRadius="4" />

                        <TextView
                            android:id="@+id/tvDescTraductor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quechua ⇄ Español"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:textColor="#F0F0F0"
                            android:layout_marginTop="4dp" />

                        <!-- Botón Probar -->
                        <TextView
                            android:id="@+id/btnEmpezarTraductor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PROBAR →"
                            android:fontFamily="@font/fredoka_one"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:background="@drawable/button_white_border"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_marginTop="12dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Lottie Animation -->
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottieTraductor"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:lottie_rawRes="@raw/animation_llama_tecleando"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 2: DICCIONARIO -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDiccionario"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/card_diccionario_gradient"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:orientation="vertical"
                        android:layout_toStartOf="@id/lottieDiccionario">

                        <TextView
                            android:id="@+id/tvTituloDiccionario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Diccionario"
                            android:fontFamily="@font/fredoka_one"
                            android:textSize="22sp"
                            android:textColor="@color/white"
                            android:shadowColor="#40000000"
                            android:shadowDx="2"
                            android:shadowDy="2"
                            android:shadowRadius="4" />

                        <TextView
                            android:id="@+id/tvDescDiccionario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Frases típicas y clásicas"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:textColor="#F0F0F0"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/btnEmpezarDiccionario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EMPEZAR →"
                            android:fontFamily="@font/fredoka_one"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:background="@drawable/button_white_border"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_marginTop="12dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottieDiccionario"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:lottie_rawRes="@raw/animation_llama_terminoleccion"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 3: PRONUNCIACIÓN -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPronunciacion"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/card_pronunciacion_gradient"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:orientation="vertical"
                        android:layout_toStartOf="@id/lottiePronunciacion">

                        <TextView
                            android:id="@+id/tvTituloPronunciacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pronunciación"
                            android:fontFamily="@font/fredoka_one"
                            android:textSize="22sp"
                            android:textColor="@color/white"
                            android:shadowColor="#40000000"
                            android:shadowDx="2"
                            android:shadowDy="2"
                            android:shadowRadius="4" />

                        <TextView
                            android:id="@+id/tvDescPronunciacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Practica tu pronunciación"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:textColor="#F0F0F0"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/btnEmpezarPronunciacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EMPEZAR →"
                            android:fontFamily="@font/fredoka_one"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:background="@drawable/button_white_border"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_marginTop="12dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottiePronunciacion"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:lottie_rawRes="@raw/animation_llama_saludando"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>