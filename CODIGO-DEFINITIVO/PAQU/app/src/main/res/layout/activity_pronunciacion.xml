<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_cross"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="🎤 Pronunciación"
            android:fontFamily="@font/fredoka_one"
            android:textSize="24sp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tvPuntaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Puntaje: 0"
            android:fontFamily="@font/fredoka_one"
            android:textSize="14sp"
            android:textColor="@color/morado"
            android:background="@drawable/bg_badge_available"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <!-- Indicador de Nivel -->
            <View
                android:id="@+id/indicadorNivel"
                android:layout_width="80dp"
                android:layout_height="4dp"
                android:background="@color/morado"
                android:layout_marginBottom="20dp" />

            <!-- Card Palabra -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPalabra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="30dp"
                    android:background="@drawable/card_traductor_gradient"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Palabra:"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="16sp"
                        android:textColor="#E0E0E0"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvPalabraActual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allinllachu"
                        android:fontFamily="@font/fredoka_one"
                        android:textSize="36sp"
                        android:textColor="@color/white"
                        android:shadowColor="#40000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="4"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tvTraduccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿Cómo estás?"
                        android:fontFamily="sans-serif"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:textStyle="italic" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Instrucciones -->
            <TextView
                android:id="@+id/tvInstrucciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎤 Presiona el botón y pronuncia la palabra"
                android:fontFamily="sans-serif-medium"
                android:textSize="16sp"
                android:textColor="@color/grey"
                android:textAlignment="center"
                android:layout_marginBottom="24dp" />

            <!-- Animación Lottie -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieAnimacion"
                android:layout_width="200dp"
                android:layout_height="200dp"
                app:lottie_rawRes="@raw/microphone_animation"
                app:lottie_loop="true"
                android:layout_marginBottom="24dp" />

            <!-- Botón Grabar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGrabar"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:text="🎤 GRABAR"
                android:fontFamily="@font/fredoka_one"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/morado"
                app:cornerRadius="30dp"
                app:elevation="8dp"
                android:layout_marginBottom="16dp" />

            <!-- ProgressBar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/morado"
                android:visibility="gone"
                android:layout_marginBottom="20dp" />

            <!-- Card Resultado -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="@drawable/card_pronunciacion_gradient"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvResultado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¡Excelente! 🌟\nPuntaje: 95/100"
                        android:fontFamily="@font/fredoka_one"
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:textAlignment="center"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRepetir"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:text="🔄 Repetir"
                            android:fontFamily="@font/fredoka_one"
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:backgroundTint="#00FFFFFF"
                            app:strokeColor="@color/white"
                            app:strokeWidth="2dp"
                            app:cornerRadius="25dp"
                            android:layout_marginEnd="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSiguiente"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:text="Siguiente →"
                            android:fontFamily="@font/fredoka_one"
                            android:textSize="14sp"
                            android:textColor="@color/morado"
                            android:backgroundTint="@color/white"
                            app:cornerRadius="25dp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>